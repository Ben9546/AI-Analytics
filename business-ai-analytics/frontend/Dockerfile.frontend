# Stage 1: Build the React application
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package.json and package-lock.json (or yarn.lock)
COPY package.json ./
# If using yarn:
# COPY yarn.lock ./
# RUN yarn install
# If using npm:
COPY package-lock.json ./
RUN npm ci

# Copy the rest of the application code
COPY . .

# Build the application
# Replace 'build' with your actual build script if different (e.g., 'build:prod')
RUN npm run build
# If using yarn:
# RUN yarn build

# Stage 2: Serve the application using a lightweight web server (e.g., Nginx)
FROM nginx:1.25-alpine

# Copy the build output from the builder stage to Nginx's web root directory
COPY --from=builder /app/build /usr/share/nginx/html

# Copy a custom Nginx configuration if needed
# For React Router, you often need to configure Nginx to serve index.html for any 404s
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]

